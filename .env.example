# SupportPilot AI — environment template.
# Copy to .env and fill in:  cp .env.example .env
# docker compose reads .env automatically and passes these values to the
# api service (see the `environment:` block in docker-compose.yml).
# NEVER commit a real .env.
#
# Everything below is OPTIONAL for local dev: with no .env at all the
# stack runs on the offline AI provider, billing disabled, the dev JWT
# key, and the default SQLite path.

# --- Runtime -------------------------------------------------------------
# Development (seeds the Acme Outdoors demo + enables Swagger) or Production.
ASPNETCORE_ENVIRONMENT=Development

# --- JWT -----------------------------------------------------------------
# Signing key for dashboard logins (32+ characters). The compose file's
# built-in default is for local dev ONLY — always set your own here for
# anything beyond your laptop. Generate one with e.g.:
#   openssl rand -base64 48
Jwt__Key=dev-only-signing-key-change-in-production-supportpilot-2026

# --- Database ------------------------------------------------------------
# SQLite connection string. Inside Docker the database lives on the
# api-data named volume at /app/data/supportpilot.db. When running the
# API without Docker, a relative path like the one below works too.
ConnectionStrings__DefaultConnection=Data Source=/app/data/supportpilot.db

# --- AI provider ---------------------------------------------------------
# offline = built-in provider, zero keys: TF-IDF retrieval over your
#           knowledge chunks + extractive answers with source citations.
#           (It is retrieval, not an LLM — see README.)
# openai  = any OpenAI-compatible chat + embeddings endpoint.
Ai__Provider=offline

# Only needed when Ai__Provider=openai:
OpenAi__ApiKey=
OpenAi__BaseUrl=https://api.openai.com/v1
OpenAi__ChatModel=gpt-4o-mini
OpenAi__EmbeddingModel=text-embedding-3-small

# --- Stripe billing (test mode) ------------------------------------------
# Leave all three empty and billing is disabled gracefully — the rest of
# the product works normally. Use TEST keys only (sk_test_ / pk_test_ /
# whsec_ from dashboard.stripe.com/test) unless you are deploying for
# real; see docs/deploy.md for the webhook setup.
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=
Stripe__StarterPriceId=
Stripe__ProPriceId=
# Where Stripe sends the user back after checkout / from the billing portal.
# Defaults in docker-compose.yml already point at http://localhost:3000/billing.
Stripe__SuccessUrl=
Stripe__CancelUrl=
Stripe__PortalReturnUrl=
